rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User raw video uploads
    match /users/{userId}/raw_videos/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024 * 1024 // 2GB Max
                   && request.resource.contentType.matches('video/.*');
    }
    
    // Generated clips & thumbnails
    match /users/{userId}/clips/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public demo clips / showcase (read-only for guests)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Admin-only via backend SDK
    }
  }
}
