# Excerpt - Environment Variables
# Copy this file to .env and fill in the values before running the worker

# --- Artificial Intelligence Providers ---
# Required for Transcription (Step 6)
GROQ_API_KEY="gsk_..."

# Required for Multi-Agent Evaluators (Step 6) and Reward Model (V5.7)
OPENAI_API_KEY="sk-..."
# (Optional) Alternative LLM provider
ANTHROPIC_API_KEY=""

# --- Core Infrastructure ---
# Required for BullMQ job queues and Fan-in Coordinator (Step 10.5)
REDIS_URL="redis://127.0.0.1:6379"

# Required for Prisma ORM / job state tracking
DATABASE_URL="postgresql://user:password@localhost:5432/excerpt?schema=public"

# --- Storage (AWS S3 or GCS) ---
# Required for uploading rendered MP4 artifacts and Playback Validation (Step 12)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="excerpt-media-artifacts"

# --- System Dependencies ---
# Ensure FFmpeg is installed and accessible in the system PATH.
# FFMPEG_PATH="/usr/bin/ffmpeg" # Optional: if not in PATH
