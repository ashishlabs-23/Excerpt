# Excerpt - Environment Variables
# Copy this file to .env and fill in the required values

# --- Server & Runtime Mode ---
NODE_ENV=development
PORT=8010
WORKER_ENV=development
# Set to 'false' if running worker processes in dedicated containers
SPAWN_WORKERS=true
# Set to 'true' to run only the background workers (skipping HTTP API)
WORKER_ONLY=false

# --- AI Providers ---
# Google Gemini (Primary for multimodal reasoning & hook detection)
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=

# Groq (Whisper-large-v3 transcription & fast inference)
GROQ_API_KEY=

# ElevenLabs (AI Voiceover generation)
ELEVENLABS_API_KEY=

# --- Database & Queue (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Firebase (Authentication & Client Sync) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Cloud Storage (Backblaze B2 / S3-compatible) ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT=

# --- Ingestion & YouTube Anti-Bot ---
# Base64-encoded Netscape-format cookie file for yt-dlp
YTDLP_COOKIES_B64=

# --- Security & Rate Limiting ---
EXCERPT_JOB_SUBMISSION_TOKEN=
CORS_ORIGIN=
DISABLE_OWNERSHIP_CHECKS=false
